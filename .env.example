# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-api-key-here"

ANTHROPIC_MODEL="claude-sonnet-5"

# Optional: max output tokens for educational packs (default 32000; uses streaming)
# ANTHROPIC_MAX_TOKENS="32000"

# Optional: Anthropic client timeout in seconds (default 1200 for long packs)
# ANTHROPIC_TIMEOUT_SECONDS="1200"

# Optional: Tesseract OCR path (Windows) — only if not on PATH
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
