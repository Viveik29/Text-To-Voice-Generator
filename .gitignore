# --- Secrets (never commit) ---
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
myenv/
.venv/
venv/
env/

# --- App runtime outputs (regenerated on each run) ---
artifacts/
output/
uploads/
extracted_txt/

# --- Piper TTS models (~60 MB each; auto-downloaded via tts_engine) ---
voices/*.onnx
# Keep voices/*.onnx.json — small config files, safe to commit

# --- Local temp / debug dumps (root) ---
_tmp*
_ocr*
_png_run_*
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/

